{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopnil",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopnil",
      "database_id": "943055df-455f-4cb1-b943-460cbdb20469",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "shopnil"
    }
  ]
}
